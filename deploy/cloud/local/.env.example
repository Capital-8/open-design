# Copy to the ignored repository-root .env.cloud-local.local, then replace placeholders.
# Docker Compose infrastructure; absolute password-file path, containing only the password.
OD_CLOUD_LOCAL_DB_PORT=15432
OD_CLOUD_LOCAL_DB_PASSWORD_FILE=/REPLACE/absolute/path/postgres.password
# Local DB only. Match the password file; URL-encode non-hex passwords.
OD_CLOUD_DATABASE_URL=postgresql://cloud_local:REPLACE_PASSWORD@127.0.0.1:15432/open_design_cloud_local
# Stable across restarts. JSON keyring values are base64-encoded random 32-byte keys.
OD_CLOUD_CREDENTIAL_KEY_ID=local-v1
OD_CLOUD_CREDENTIAL_KEYS='{"local-v1":"REPLACE_BASE64_KEY"}'
OD_CLOUD_PROFILE=test
OD_CLOUD_HOST=127.0.0.1
OD_CLOUD_PORT=19000
# Must match the browser's actual origin, including localhost vs 127.0.0.1.
OD_CLOUD_WEB_URL=http://localhost:5182
# Existing POC cloud endpoints; no account database or runtime container is created locally.
OD_CLOUD_VELA_API_URL=https://odcloud-amr.inner.nexu.space
OD_CLOUD_VELA_WEB_URL=https://odcloud-amr.inner.nexu.space/cloud
OD_CLOUD_AMR_URL=https://amr-edge-nnrdrrtrab.cn-shanghai.fcapp.run
OD_CLOUD_RUNTIME_ID=amr-4114
OD_CLOUD_RUNTIME_RECOVERY=false
# Real resource bundle from resources:prepare:local (local only) or resources:prepare (release).
OD_CLOUD_RESOURCE_DIR=/REPLACE/absolute/path/resource-bundle
OD_CLOUD_RENDERER_HOST=127.0.0.1
OD_CLOUD_RENDERER_PORT=19001
OD_CLOUD_RENDERER_URL=http://127.0.0.1:19001
OD_CLOUD_CHROMIUM_PATH=/REPLACE/absolute/path/chromium
OD_CLOUD_FFMPEG_PATH=/REPLACE/absolute/path/ffmpeg

# Container deployment overlay; same local DB/password, reached by Docker service name.
OD_CLOUD_CONTAINER_DATABASE_URL=postgresql://cloud_local:REPLACE_PASSWORD@postgres:5432/open_design_cloud_local
OD_CLOUD_LOCAL_WEB_PORT=5182
# Build --target web first, then use the absolute export directory below.
OD_CLOUD_LOCAL_WEB_DIR=/REPLACE/repository/.tmp/web-targets/web/build/project/out
